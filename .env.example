# --- Azure OpenAI (leave empty to run the offline rule-based backend) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Service credentials (two roles: n8n vs. human reviewer) ---
ASSESSPILOT_API_KEY=change-me-service-key
ASSESSPILOT_APPROVER_KEY=change-me-reviewer-key

# --- GitLab (optional) ---
GITLAB_URL=https://gitlab.com
GITLAB_READ_TOKEN=
GITLAB_PUBLISH_TOKEN=
# Opt-in: also post approved reports as GitLab issues (outward-facing)
GITLAB_PUBLISH_ISSUES=false
